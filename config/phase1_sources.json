{
  "schemaVersion": "1.0",
  "purpose": "Machine-readable Phase 1 source registry. Collection creates reviewable signals; it does not publish events automatically.",
  "sources": [
    {
      "id": "ourairports-airports",
      "category": "AIRPORTS",
      "name": "OurAirports",
      "kind": "reference",
      "url": "https://ourairports.com/data/",
      "endpoint": "https://davidmegginson.github.io/ourairports-data/airports.csv",
      "accessMethod": "csv",
      "priority": "P0",
      "rights": "public-domain",
      "automationPermission": "yes",
      "notes": "Canonical airport reference layer. Do not treat as live operational status.",
      "fallbackEndpoints": [
        "https://raw.githubusercontent.com/davidmegginson/ourairports-data/main/airports.csv"
      ]
    },
    {
      "id": "gdelt-events",
      "category": "NEWS_EVENTS",
      "name": "GDELT",
      "kind": "discovery",
      "url": "https://gdeltproject.org/",
      "endpoint": "https://api.gdeltproject.org/api/v2/doc/doc?query=airport%20closure&mode=artlist&format=json&maxrecords=20",
      "accessMethod": "http-json",
      "priority": "P0",
      "rights": "source-specific",
      "automationPermission": "yes",
      "notes": "Discovery only. Follow the original source before creating a TI event."
    },
    {
      "id": "gdacs-alerts",
      "category": "DISASTERS",
      "name": "GDACS",
      "kind": "alert",
      "url": "https://www.gdacs.org/",
      "endpoint": "https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH",
      "accessMethod": "http-json",
      "priority": "P0",
      "rights": "source-specific",
      "automationPermission": "yes",
      "notes": "Disaster signal source. Endpoint availability/schema should be validated at runtime."
    },
    {
      "id": "nasa-firms",
      "category": "FIRE",
      "name": "NASA FIRMS",
      "kind": "observation",
      "url": "https://firms.modaps.eosdis.nasa.gov/",
      "endpoint": "https://firms.modaps.eosdis.nasa.gov/api/area/csv/",
      "accessMethod": "public-csv-or-api-key",
      "priority": "P0",
      "rights": "source-specific",
      "automationPermission": "yes",
      "notes": "Public S-NPP VIIRS C2 24-hour CSV is available without a key. Optional MAP_KEY stays in Actions secrets. Hotspots are observations, not confirmed fires or travel incidents.",
      "publicEndpoint": "https://firms.modaps.eosdis.nasa.gov/data/active_fire/suomi-npp-viirs-c2/csv/SUOMI_VIIRS_C2_Global_24h.csv"
    },
    {
      "id": "adsblol-aircraft",
      "category": "AVIATION",
      "name": "ADSB.lol",
      "kind": "live-signal",
      "url": "https://www.adsb.lol/",
      "endpoint": "https://api.adsb.lol/v2/point/{lat}/{lon}/{radius}",
      "accessMethod": "http-json",
      "priority": "P0",
      "rights": "odbl",
      "automationPermission": "yes",
      "notes": "One scheduled large/medium airport per tracked country, where available; bounded geographic sample, never global coverage or proof of operational status. ODbL attribution retained.",
      "radiusNm": 100
    },
    {
      "id": "reliefweb-disasters",
      "category": "HUMANITARIAN",
      "name": "ReliefWeb",
      "kind": "discovery",
      "url": "https://reliefweb.int/",
      "endpoint": "https://api.reliefweb.int/v2/reports",
      "accessMethod": "http-json",
      "priority": "P0",
      "rights": "source-specific",
      "automationPermission": "yes",
      "notes": "Requires a provider-approved RELIEFWEB_APPNAME. Do not impersonate another application. Discovery only; original publisher rights apply.",
      "appnameEnvironment": "RELIEFWEB_APPNAME"
    }
  ]

{
  "_comment": "03AA-04_Country_Intelligence_Builder_TI. Committed operating configuration (no secrets). Repository variables TI_CB_* override these values when set. TI_CB_MODE=off or disabling the workflow stops the agent. Operating model (supersedes the draft-only design, Marc 22 Oct 2026): content that passes the publication rules is published automatically through a compare-and-swap commit to main and verified on the live site; only exceptions are held and routed through the Master Agent. See docs/TI_COUNTRY_INTELLIGENCE_BUILDER.md.",
  "agent": "03AA-04_Country_Intelligence_Builder_TI",
  "operation": {
    "_approval": "Operating model corrected by Marc on 22 Oct 2026: automatic publication of content that passes the rules; exceptions only are held. Publication is enabled in the same change that adds the rules, the tests and the live-site verification.",
    "mode": "publish",
    "state_branch": "ti-country-drafts"
  },
  "scope": {
    "_approval": "Validation scope: Ghana and three categories (ENVIRONMENT, TRANSPORT, EQUIPMENT), all three processed in one run. Expansion beyond this is automatic only when the proof gate below is met AND scope.expansion.enabled is true; enabling it is a separate confirmation of coverage and budget.",
    "countries": [
      "gh"
    ],
    "categories": [
      "ENVIRONMENT",
      "TRANSPORT",
      "EQUIPMENT"
    ],
    "batch_size_tasks_per_run": 3,
    "gap_types": [
      "MISSING",
      "STALE"
    ],
    "stale_after_days_since_checked": 365,
    "expansion": {
      "enabled": false,
      "countries": "all_active",
      "categories": [
        "ENVIRONMENT",
        "TRANSPORT",
        "EQUIPMENT"
      ],
      "max_new_countries_per_run": 1,
      "gate": {
        "min_published_records": 3,
        "min_verified_on_live_site": 3,
        "max_rollbacks": 0,
        "min_clean_publication_runs": 2
      }
    }
  },
  "schedule": {
    "_note": "Trigger for the GitHub Actions workflow (.github/workflows/country-intelligence-builder.yml). GitHub may delay scheduled runs.",
    "cron_utc": "41 5 * * *",
    "recheck_after_days": 7
  },
  "freshness": {
    "_note": "Per-source limits live on each source (stale_after_days). CURRENT claims need a source marked current_capable, retrieved in this run, and inside its limit. STABLE claims may use stale-but-dated reference material only when flagged.",
    "max_evidence_age_hours_for_reuse": 24,
    "drop_stale_sources": true
  },
  "retention": {
    "superseded_drafts_keep": 3,
    "run_history_keep": 100,
    "closed_task_days": 60
  },
  "evidence_limits": {
    "max_bytes_per_page": 1500000,
    "http_timeout_seconds": 20,
    "http_attempts": 2,
    "max_passages_per_topic": 8,
    "max_passages_per_task": 14,
    "max_passage_chars": 600,
    "max_prompt_chars": 9000,
    "min_quote_chars": 12,
    "max_quote_chars": 400
  },
  "spending": {
    "_approval": "UNSET. No paid model call is authorised yet. The ordinary-code (extractive) path needs no model and costs nothing. Model drafting is only used for topics the ordinary-code path cannot cover, and each model-written claim is independently verified before it can publish. Proposed limits are in docs/TI_COUNTRY_INTELLIGENCE_BUILDER.md.",
    "dry_run": true,
    "per_task_limit_usd": null,
    "daily_limit_usd": null,
    "monthly_limit_usd": null,
    "total_limit_usd": null,
    "max_output_tokens": 2000,
    "model_timeout_seconds": 60,
    "sonnet_escalation_enabled": false,
    "opus_enabled": false,
    "verifier_enabled": true
  },
  "review": {
    "human_review": "exceptions_only",
    "note": "Nothing waits for review by default. An item that fails a rule is held with its reasons and routed through the Master Agent."
  },

  "publication": {
    "enabled": true,
    "allowed_events": [
      "schedule",
      "workflow_dispatch"
    ],
    "required_ref": "refs/heads/main",
    "target_branch": "main",
    "max_records_per_run": 8,
    "min_claims_per_record": 1,
    "max_claims_per_record": 8,
    "duplicate_similarity": 0.85,
    "review_days": 90,
    "registry": {
      "file": "config/source_registry.json",
      "allowed_tiers": [
        "TIER_1"
      ],
      "allowed_status": [
        "ACTIVE",
        "INTEGRATION_READY"
      ],
      "allowed_automation": [
        "YES",
        "REVIEWED"
      ]
    },
    "quality": {
      "min_words": 4,
      "max_words": 90
    },
    "update_policy": {
      "replace_only_builder_published": true,
      "keep_existing_when_replacement_fails": true
    },
    "verification": {
      "site_url_from": "config/production_controller.json",
      "timeout_seconds": 900,
      "interval_seconds": 20,
      "rollback_on_incorrect_content": true,
      "max_rechecks": 6,
      "recheck_timeout_seconds": 120
    },
    "refresh_days": 7
  }
